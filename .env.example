# Copy to .env for local testing only. In production, set these as
# environment variables on your hosting platform (Render/Railway/Fly) —
# never commit real values.

# --- Access control for THIS hosted server -----------------------------
# Long random secret Claude will send back on every request. Generate one
# with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_ACCESS_TOKEN=

# --- OwnerRez credentials (Personal Access Token) -----------------------
# From OwnerRez: Settings > (API / Integrations) > Personal Access Tokens.
# See https://www.ownerrez.com/support/articles/api-auth
OWNERREZ_USERNAME=
OWNERREZ_TOKEN=

# Set to 1 to disable all write tools (send_message, webhook subscription
# create/delete). OwnerRez's account-level API has no way to create or
# modify bookings or block calendar dates at all — see README — so this
# only gates guest messaging and webhook management, not bookings.
OWNERREZ_READ_ONLY=1
